[Unit]
Description=Dashboard MyGES (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=user
WorkingDirectory=/home/user/myges-dash
ExecStart=/home/user/myges-dash/venv/bin/uvicorn app:app --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure

[Install]
WantedBy=multi-user.target
